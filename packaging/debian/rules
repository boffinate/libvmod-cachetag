#!/usr/bin/make -f
#
# libvmod-cachetag -- Debian packaging rules.
#
# STATUS: scaffolding, never executed. See ../README.md.
#
# This file is a template. At-sign delimited tokens are substituted from the
# release cohort/target manifests before dpkg-buildpackage runs. Every token
# used here is documented in ../README.md.
#
# Design rules taken from the packaging plan (Phase 3):
#   - build from the tagged upstream source archive, never a git checkout;
#   - build against an installed vinyl-cache-dev package, never an unpackaged
#     prefix;
#   - stage through DESTDIR;
#   - ship the .so, the manual page, the VCC interface and useful docs only;
#   - remove libtool .la files and static archives;
#   - install no daemon, user, service unit, default VCL or restart hook;
#   - leave distribution hardening, shlibdeps and debug-symbol splitting to
#     debhelper.

# Full distribution hardening. The upstream diagnostic harness configures
# Vinyl Cache with --disable-stack-protector; production package builds must
# never inherit that, so state the intent explicitly here.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# The VMOD must be installed into the directory the *installed* Vinyl Cache
# runtime searches, which vinylapi.pc reports as ${libdir}/vinyl-cache/vmods.
# Take libdir from the development package rather than from debhelper's
# multiarch default, then require the resulting vmoddir to match the value
# recorded in the target manifest.
VINYL_LIBDIR := $(shell pkg-config --variable=libdir vinylapi)
VINYL_VMODDIR := $(shell pkg-config --define-variable=libdir=$(VINYL_LIBDIR) --variable=vmoddir vinylapi)
VINYL_INCDIR := $(shell pkg-config --variable=pkgincludedir vinylapi)

# Expected values from the release manifests.
EXPECTED_VMODDIR := @VINYL_VMODDIR@

PKG := libvmod-cachetag
STAGEDIR := debian/$(PKG)
DOCDIR := /usr/share/doc/$(PKG)

# --without autoreconf is deliberate and load-bearing, not a convenience.
#
# Makefile.am declares
#     ACLOCAL_AMFLAGS = -I m4 -I ${VINYLAPI_DATAROOTDIR}/aclocal
# and VINYLAPI_DATAROOTDIR is a configure-time substitution read from the
# installed vinylapi.pc. dh_autoreconf runs aclocal *before* configure, where
# that variable is empty, so autoreconf fails with
#     aclocal: error: couldn't open directory '/aclocal'
#
# It should not run in any case. This package is built from the tagged release
# archive, which already contains configure, aclocal.m4, Makefile.in and
# config.h.in generated by the release build; regenerating them with whatever
# autotools the buildroot happens to carry would replace the build system that
# the release archive was tested with, which is exactly what "the generated
# distribution archive must be the only source input consumed by native
# package jobs" exists to prevent. dh_update_autotools_config still runs and
# still refreshes config.guess and config.sub, which is the portability
# requirement autoreconf is usually invoked to satisfy.
%:
	dh $@ --without autoreconf

override_dh_auto_configure:
	@if [ -z "$(VINYL_LIBDIR)" ]; then \
		echo "E: vinylapi.pc not found; vinyl-cache-dev is not installed" >&2; \
		exit 1; \
	fi
	@if [ "$(VINYL_VMODDIR)" != "$(EXPECTED_VMODDIR)" ]; then \
		echo "E: vinylapi vmoddir '$(VINYL_VMODDIR)' does not match the" >&2; \
		echo "E: manifest value '$(EXPECTED_VMODDIR)'. Refusing to build a" >&2; \
		echo "E: VMOD that the packaged runtime would not find." >&2; \
		exit 1; \
	fi
	dh_auto_configure -- \
		--libdir=$(VINYL_LIBDIR) \
		--docdir=$(DOCDIR)

# The VTC suite needs a running vinyltest and a matching runtime, which is the
# job of the installed-package smoke test after the package is built. At build
# time run only the self-contained WAL unit test.
override_dh_auto_test:
	dh_auto_test -- TESTS=cachetag_wal_test

override_dh_auto_install:
	dh_auto_install
	find $(STAGEDIR) -name '*.la' -delete
	find $(STAGEDIR) -name '*.a' -delete
	@if [ ! -f "$(STAGEDIR)$(EXPECTED_VMODDIR)/libvmod_cachetag.so" ]; then \
		echo "E: libvmod_cachetag.so was not staged in $(EXPECTED_VMODDIR)" >&2; \
		exit 1; \
	fi

# Fail the build when the installed development package does not carry the
# strict ABI the manifest promised, rather than shipping a package whose
# vinyld-abi-@VINYL_STRICT_ABI@ dependency is a lie. vmod_abi.h holds
#   #define VMOD_ABI_Version "Vinyl Cache <version> <hash>"
# and the trailing field is the hash used by the virtual package name.
override_dh_install:
	dh_install
	@set -e; \
	hdr="$(VINYL_INCDIR)/vmod_abi.h"; \
	if [ ! -f "$$hdr" ]; then \
		echo "E: $$hdr not found in the vinyl-cache-dev package" >&2; \
		exit 1; \
	fi; \
	abi=$$(sed -n 's/^#define[[:space:]]\+VMOD_ABI_Version[[:space:]]\+"\(.*\)"[[:space:]]*$$/\1/p' "$$hdr" | awk 'NR == 1 { print $$NF }'); \
	if [ "$$abi" != "@VINYL_STRICT_ABI@" ]; then \
		echo "E: installed Vinyl Cache strict ABI '$$abi' does not match" >&2; \
		echo "E: the manifest value '@VINYL_STRICT_ABI@'" >&2; \
		exit 1; \
	fi
