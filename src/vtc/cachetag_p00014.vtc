vtest "cachetag duplicate namespace identities use strict volatile fallback"

server s1 {
	rxreq
	expect req.url == "/duplicate-namespace"
	txresp -hdr "Connection: close" -body "old"

	expect_close
	accept
	rxreq
	expect req.url == "/duplicate-namespace"
	txresp -hdr "Connection: close" -body "left-refetched"

	expect_close
	accept
	rxreq
	expect req.url == "/duplicate-namespace"
	txresp -body "right-refetched"
} -start

vinyl v1 \
	-arg "-jnone" \
	-arg "-E${libvmod_slash}" \
	-arg "-sfellow=fellow,${tmpdir}/duplicate-namespace.stv,100MB,1MB,64KB" \
	-vcl+backend {
	import slash from "${libvmod_slash}";
	import cachetag;

	sub vcl_init {
		slash.tune_fellow(storage.fellow);
		new left = cachetag.namespace("duplicate_pm",
		    persist_path = "${tmpdir}/left-persist",
		    sweep_interval = 0s);
		new right = cachetag.namespace("duplicate_pm",
		    persist_path = "${tmpdir}/right-persist",
		    sweep_interval = 0s);
	}

	sub vcl_recv {
		if (req.method == "PURGE") {
			if (req.http.Namespace == "left") {
				set req.http.purged = left.purge("left-key");
			} else {
				set req.http.purged = right.purge("right-key");
			}
			return (synth(200));
		}
	}

	sub vcl_backend_response {
		left.add("left-key");
		right.add("right-key");
		set beresp.ttl = 1h;
	}

	sub vcl_hit {
		if (left.stale() || right.stale()) {
			return (restart);
		}
	}

	sub vcl_synth {
		set resp.http.purged = req.http.purged;
		return (deliver);
	}
} -start

client c1 {
	txreq -url "/duplicate-namespace"
	rxresp
	expect resp.status == 200
	expect resp.body == "old"
} -run

vinyl v1 -expect CACHETAG.vcl1_left_duplicate_pm.purgemap_fellow_attr_objects_written == 0
vinyl v1 -expect CACHETAG.vcl1_right_duplicate_pm.purgemap_fellow_attr_objects_written == 0
vinyl v1 -expect CACHETAG.vcl1_left_duplicate_pm.purgemap_volatile_fallback_attaches == 1
vinyl v1 -expect CACHETAG.vcl1_right_duplicate_pm.purgemap_volatile_fallback_attaches == 1
vinyl v1 -expect CACHETAG.vcl1_left_duplicate_pm.purgemap_fellow_store_invariant_failures == 0
vinyl v1 -expect CACHETAG.vcl1_right_duplicate_pm.purgemap_fellow_store_invariant_failures == 0
vinyl v1 -expect CACHETAG.vcl1_left_duplicate_pm.volatile_objects == 1
vinyl v1 -expect CACHETAG.vcl1_right_duplicate_pm.volatile_objects == 1

client c2 {
	txreq -req PURGE -hdr "Namespace: left"
	rxresp
	expect resp.status == 200
	expect resp.http.purged == -1

	txreq -url "/duplicate-namespace"
	rxresp
	expect resp.status == 200
	expect resp.body == "left-refetched"

	txreq -req PURGE -hdr "Namespace: right"
	rxresp
	expect resp.status == 200
	expect resp.http.purged == -1

	txreq -url "/duplicate-namespace"
	rxresp
	expect resp.status == 200
	expect resp.body == "right-refetched"
} -run

server s1 -wait
