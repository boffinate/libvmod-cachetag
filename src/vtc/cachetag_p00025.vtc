vtest "persistent cap prunes complete purge_header sequence groups"

server s1 {
	rxreq
	expect req.url == "/one"
	txresp -hdr "Connection: close" -hdr "X-Source: one-old" -body "one-old"
	expect_close
	accept

	rxreq
	expect req.url == "/three"
	txresp -hdr "Connection: close" -hdr "X-Source: three-old" -body "three-old"
	expect_close
	accept

	rxreq
	expect req.url == "/one"
	txresp -hdr "Connection: close" -hdr "X-Source: one-new" -body "one-new"
	expect_close
	accept

	rxreq
	expect req.url == "/three"
	txresp -hdr "Connection: close" -hdr "X-Source: three-new" -body "three-new"
} -start

vinyl v1 \
	-arg "-jnone" \
	-arg "-E${libvmod_slash}" \
	-arg "-sfellow=fellow,${tmpdir}/purgemap-header-cap.stv,100MB,1MB,64KB" \
	-vcl+backend {
	import slash from "${libvmod_slash}";
	import cachetag;

	sub vcl_init {
		slash.tune_fellow(storage.fellow);
		new tags = cachetag.namespace("header_cap",
		    persist_path = "${tmpdir}/tag-persist",
		    purge_history_max_entries = 4,
		    sweep_interval = 0s);
	}

	sub vcl_recv {
		if (req.method == "PURGE") {
			set req.http.purged = tags.purge_header(req.http.Tags);
			return (synth(200));
		}
	}

	sub vcl_backend_response {
		if (bereq.url == "/one") {
			tags.add("one");
		} else {
			tags.add("three");
		}
		set beresp.ttl = 1h;
	}

	sub vcl_hit {
		if (tags.stale()) {
			return (restart);
		}
	}

	sub vcl_synth {
		set resp.http.purged = req.http.purged;
		return (deliver);
	}
} -start

client c1 {
	txreq -url "/one"
	rxresp
	expect resp.http.X-Source == "one-old"

	txreq -url "/three"
	rxresp
	expect resp.http.X-Source == "three-old"

	txreq -req PURGE -hdr "Tags: one,two"
	rxresp
	expect resp.http.purged == -1

	txreq -req PURGE -hdr "Tags: three,four"
	rxresp
	expect resp.http.purged == -1

	txreq -req PURGE -hdr "Tags: five,six"
	rxresp
	expect resp.http.purged == -1
} -run

vinyl v1 -expect CACHETAG.vcl1_tags_header_cap.purgemap_seq == 3
vinyl v1 -expect CACHETAG.vcl1_tags_header_cap.purgemap_entries <= 4
vinyl v1 -expect CACHETAG.vcl1_tags_header_cap.purgemap_hard_floor >= 2

client c2 {
	txreq -url "/one"
	rxresp
	expect resp.http.X-Source == "one-new"

	txreq -url "/three"
	rxresp
	expect resp.http.X-Source == "three-new"
} -run

server s1 -wait
