vtest "cachetag purgemap Fellow valid FDO envelope missing namespace stays fresh"

server s1 {
	rxreq
	expect req.url == "/missing-namespace"
	txresp -hdr "X-Source: backend-old" -body "old-body"
} -start

vinyl v1 \
	-arg "-jnone" \
	-arg "-E${libvmod_slash}" \
	-arg "-sfellow=fellow,${tmpdir}/purgemap-missing-namespace.stv,100MB,1MB,64KB" \
	-vcl+backend {
	import slash from "${libvmod_slash}";
	import cachetag;

	sub vcl_init {
		slash.tune_fellow(storage.fellow);
		new stored = cachetag.namespace("stored_pm",
		    persist_path = "${tmpdir}/stored-persist",
		    sweep_interval = 0s);
		new query = cachetag.namespace("query_pm",
		    persist_path = "${tmpdir}/query-persist",
		    sweep_interval = 0s);
	}

	sub vcl_recv {
		if (req.method == "PURGE") {
			set req.http.purged = query.purge("query-only");
			return (synth(200));
		}
	}

	sub vcl_backend_response {
		stored.add("stored-only");
		set beresp.ttl = 1h;
	}

	sub vcl_hit {
		if (query.stale()) {
			return (restart);
		}
	}

	sub vcl_synth {
		set resp.http.purged = req.http.purged;
		return (deliver);
	}
} -start

client c1 {
	txreq -url "/missing-namespace"
	rxresp
	expect resp.status == 200
	expect resp.http.X-Source == "backend-old"
	expect resp.body == "old-body"
} -run

vinyl v1 -expect CACHETAG.vcl1_stored_stored_pm.purgemap_fellow_attr_objects_written == 1
vinyl v1 -expect CACHETAG.vcl1_stored_stored_pm.purgemap_fellow_attr_bytes_written == 40
vinyl v1 -expect CACHETAG.vcl1_stored_stored_pm.volatile_objects == 0
vinyl v1 -expect CACHETAG.vcl1_stored_stored_pm.volatile_edges == 0

vinyl v1 -stop
vinyl v1 -start
vinyl v1 -expect n_vampireobject == 1

client c2 {
	txreq -req PURGE
	rxresp
	expect resp.status == 200
	expect resp.http.purged == -1

	txreq -url "/missing-namespace"
	rxresp
	expect resp.status == 200
	expect resp.http.X-Source == "backend-old"
	expect resp.body == "old-body"
} -run

vinyl v1 -expect CACHETAG.vcl1_query_query_pm.purgemap_entries >= 1
vinyl v1 -expect CACHETAG.vcl1_query_query_pm.purgemap_fellow_attr_absent == 0
vinyl v1 -expect CACHETAG.vcl1_query_query_pm.purgemap_fellow_attr_read_failures == 0
vinyl v1 -expect CACHETAG.vcl1_query_query_pm.purgemap_fellow_direct_probes >= 1
vinyl v1 -expect CACHETAG.vcl1_query_query_pm.purgemap_fellow_namespace_records_probed == 0
vinyl v1 -expect CACHETAG.vcl1_query_query_pm.purgemap_fellow_attr_invalid == 0
vinyl v1 -expect CACHETAG.vcl1_query_query_pm.volatile_objects == 0
vinyl v1 -expect CACHETAG.vcl1_query_query_pm.volatile_edges == 0
vinyl v1 -expect CACHETAG.vcl1_query_query_pm.volatile_side_table_bytes == 0

server s1 -wait
