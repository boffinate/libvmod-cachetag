vtest "tag concurrent purges across multiple tags on one object"

barrier b_tagged sock 2
barrier b_body cond 2

server s1 {
	rxreq
	txresp -nolen -hdr "Transfer-Encoding: chunked" -hdr "X-Tag-Barrier: 1"
	barrier b_body sync
	chunked "old"
	chunkedlen 0

	rxreq
	txresp -body "new"
} -start

vinyl v1 -vcl+backend {
	import cachetag;
	import vtc;

	sub vcl_init {
		new tags = cachetag.namespace("default");
	}

	sub vcl_recv {
		if (req.method == "PURGE-A") {
			set req.http.purged = tags.purge("a");
			return (synth(200));
		}
		if (req.method == "PURGE-B") {
			set req.http.purged = tags.purge("b");
			return (synth(200));
		}
	}

	sub vcl_backend_response {
		tags.add("a");
		tags.add("b");
		if (beresp.http.X-Tag-Barrier) {
			unset beresp.http.X-Tag-Barrier;
			vtc.barrier_sync("${b_tagged_sock}");
		}
	}

	sub vcl_hit {
		if (tags.stale()) {
			return (restart);
		}
	}
} -start

client c1 {
	txreq
	rxresp
	expect resp.status == 200
} -start

barrier b_tagged sync

client c2 {
	txreq -req PURGE-A
	rxresp
	expect resp.status == 200
} -start

client c3 {
	txreq -req PURGE-B
	rxresp
	expect resp.status == 200
} -run

client c2 -wait
barrier b_body sync
client c1 -wait

client c4 {
	txreq
	rxresp
	expect resp.status == 200
	expect resp.body == "new"
} -run
