vtest "cachetag Fellow provider discovery recovers after a missing API"

server s1 {
	rxreq
	expect req.url == "/provider-recovery"
	txresp -body "recovered"
} -start

vinyl v1 -arg "-jnone" -vcl+backend {
	import cachetag;

	sub vcl_init {
		new keep = cachetag.namespace("volatile");
	}
} -start

vinyl v1 -errvcl {VCL "vcl2" Failed initialization} {
	import cachetag;

	backend default {
		.host = "${s1_addr}";
		.port = "${s1_port}";
	}

	sub vcl_init {
		new doomed = cachetag.namespace("doomed_pm",
		    persist_path = "${tmpdir}/doomed-persist",
		    sweep_interval = 0s);
	}
}

vinyl v1 -vcl+backend {
	import slash from "${libvmod_slash}";
	import cachetag;

	sub vcl_init {
		new fellow = slash.fellow(
		    "${tmpdir}/provider-recovery.stv",
		    dsksize = 100MB,
		    memsize = 1MB,
		    objsize_hint = 64KB);
		new tags = cachetag.namespace("recovered_pm",
		    persist_path = "${tmpdir}/recovered-persist",
		    sweep_interval = 0s);
	}

	sub vcl_backend_response {
		set beresp.storage = fellow.storage();
		tags.add("recovered-tag");
		set beresp.ttl = 1h;
	}
}

client c1 {
	txreq -url "/provider-recovery"
	rxresp
	expect resp.status == 200
	expect resp.body == "recovered"
} -run

vinyl v1 -expect CACHETAG.vcl3_tags_recovered_pm.purgemap_fellow_attr_objects_written == 1
vinyl v1 -expect CACHETAG.vcl3_tags_recovered_pm.purgemap_fellow_store_invariant_failures == 0
vinyl v1 -expect CACHETAG.vcl3_tags_recovered_pm.volatile_objects == 0
vinyl v1 -expect CACHETAG.vcl3_tags_recovered_pm.volatile_edges == 0

server s1 -wait
