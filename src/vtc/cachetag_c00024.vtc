} -start

vinyl v1 -vcl+backend {
	import cachetag;

	sub vcl_init {
		new tags = cachetag.namespace("bounds");
	}

	sub vcl_recv {
		if (req.method == "PURGE") {
			set req.http.purged =
			    tags.purge_header(req.http.Cache-Tag-Purge);
			return (synth(200));
		}
		if (req.method == "STATS") {
			set req.http.objects = tags.objects();
			set req.http.edges = tags.edges();
			return (synth(200));
		}
	}

	sub vcl_backend_response {
		if (beresp.http.Cache-Tag) {
			tags.add_header(beresp.http.Cache-Tag);
			unset beresp.http.Cache-Tag;
		}
	}

	sub vcl_hit {
		if (tags.stale()) {
			return (restart);
		}
	}

	sub vcl_deliver {
		if (tags.stale()) {
			return (restart);
		}
	}

	sub vcl_synth {
		set resp.http.purged = req.http.purged;
		set resp.http.objects = req.http.objects;
		set resp.http.edges = req.http.edges;
		return (deliver);
	}
} -start

client c1 {
	# Default path: a real production-shaped 333-tag object must cache.
	txreq -url "/t333"
	rxresp
	expect resp.status == 200
	expect resp.body == "obj333a"

	# Boundary accept: exactly max_keys_per_object (512) unique tags.
	txreq -url "/u512"
	rxresp
	expect resp.status == 200
	expect resp.body == "obj512"

	# Boundary accept with duplicate: 513 tokens carrying 512 unique tags
	# must cache — the limit counts unique keys after deduplication.
	txreq -url "/w513dup"
	rxresp
	expect resp.status == 200
	expect resp.body == "obj512dup"

	# An object tagged only with the LAST purge-header token: if the
	# 333-token purge below published only a prefix, this object would
	# survive it.
	txreq -url "/last"
	rxresp
	expect resp.status == 200
	expect resp.body == "lastA"

	# All four objects registered fully (333 + 512 + 512 + 1 edges).
	txreq -req STATS
	rxresp
	expect resp.http.objects == 4
	expect resp.http.edges == 1358

	# A 333-token purge header exceeds the removed 256-token ceiling and
	# must be accepted in full.
	txreq -req PURGE -hdr "Cache-Tag-Purge: t000,t001,t002,t003,t004,t005,t006,t007,t008,t009,t010,t011,t012,t013,t014,t015,t016,t017,t018,t019,t020,t021,t022,t023,t024,t025,t026,t027,t028,t029,t030,t031,t032,t033,t034,t035,t036,t037,t038,t039,t040,t041,t042,t043,t044,t045,t046,t047,t048,t049,t050,t051,t052,t053,t054,t055,t056,t057,t058,t059,t060,t061,t062,t063,t064,t065,t066,t067,t068,t069,t070,t071,t072,t073,t074,t075,t076,t077,t078,t079,t080,t081,t082,t083,t084,t085,t086,t087,t088,t089,t090,t091,t092,t093,t094,t095,t096,t097,t098,t099,t100,t101,t102,t103,t104,t105,t106,t107,t108,t109,t110,t111,t112,t113,t114,t115,t116,t117,t118,t119,t120,t121,t122,t123,t124,t125,t126,t127,t128,t129,t130,t131,t132,t133,t134,t135,t136,t137,t138,t139,t140,t141,t142,t143,t144,t145,t146,t147,t148,t149,t150,t151,t152,t153,t154,t155,t156,t157,t158,t159,t160,t161,t162,t163,t164,t165,t166,t167,t168,t169,t170,t171,t172,t173,t174,t175,t176,t177,t178,t179,t180,t181,t182,t183,t184,t185,t186,t187,t188,t189,t190,t191,t192,t193,t194,t195,t196,t197,t198,t199,t200,t201,t202,t203,t204,t205,t206,t207,t208,t209,t210,t211,t212,t213,t214,t215,t216,t217,t218,t219,t220,t221,t222,t223,t224,t225,t226,t227,t228,t229,t230,t231,t232,t233,t234,t235,t236,t237,t238,t239,t240,t241,t242,t243,t244,t245,t246,t247,t248,t249,t250,t251,t252,t253,t254,t255,t256,t257,t258,t259,t260,t261,t262,t263,t264,t265,t266,t267,t268,t269,t270,t271,t272,t273,t274,t275,t276,t277,t278,t279,t280,t281,t282,t283,t284,t285,t286,t287,t288,t289,t290,t291,t292,t293,t294,t295,t296,t297,t298,t299,t300,t301,t302,t303,t304,t305,t306,t307,t308,t309,t310,t311,t312,t313,t314,t315,t316,t317,t318,t319,t320,t321,t322,t323,t324,t325,t326,t327,t328,t329,t330,t331,t332"
	rxresp
	expect resp.status == 200
	expect resp.http.purged == -1

	# The purged 333-tag object must not be served: stale() restarts and
	# the refetch returns the new body.
	txreq -url "/t333"
	rxresp
	expect resp.status == 200
	expect resp.body == "obj333b"

	# The t332-only object proves the final purge token was published:
	# sequential publication that stopped early would leave "lastA".
	txreq -url "/last"
	rxresp
	expect resp.status == 200
	expect resp.body == "lastB"

	# The unpurged 512-tag object still serves from cache.
	txreq -url "/u512"
	rxresp
	expect resp.status == 200
	expect resp.body == "obj512"

	# Boundary reject: 513 unique tags fail the fetch, fail closed.
	txreq -url "/v513"
	rxresp
	expect resp.status == 503
} -run

server s1 -wait

vinyl v1 -expect CACHETAG.vcl1_tags_bounds.limit_rejections == 1
# Full publication of the 333-token purge is asserted behaviorally via the
# /last object above; purgemap_entries is not used because the purge map
# reclaims entries (observed 315 of 333 remaining in this scenario).
