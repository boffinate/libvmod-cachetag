vtest "cachetag purgemap failed WAL publication does not advance purge sequence"

server s1 {
	rxreq
	expect req.url == "/wal-sequence"
	txresp -hdr "Connection: close" -hdr "X-Source: backend-old" -body "old-body"

	expect_close
	accept

	rxreq
	expect req.url == "/wal-sequence"
	txresp -hdr "X-Source: backend-new" -body "new-body"
} -start

vinyl v1 \
	-arg "-jnone" \
	-arg "-E${libvmod_slash}" \
	-arg "-sfellow=fellow,${tmpdir}/purgemap-wal-sequence.stv,100MB,1MB,64KB" \
	-vcl+backend {
	import slash from "${libvmod_slash}";
	import cachetag;

	sub vcl_init {
		slash.tune_fellow(storage.fellow);
		new tags = cachetag.namespace("persistent_pm",
		    persist_path = "${tmpdir}/tag-persist",
		    sweep_interval = 0s);
	}

	sub vcl_recv {
		if (req.method == "PURGE") {
			if (req.http.Fail-WAL == "1") {
				set req.http.fail-wal =
				    tags.test_fail_next_key_purge_wal();
			}
			set req.http.purged = tags.purge("wal-sequence-tag");
			return (synth(200));
		}
	}

	sub vcl_backend_response {
		tags.add("wal-sequence-tag");
		set beresp.ttl = 1h;
	}

	sub vcl_hit {
		if (tags.stale()) {
			return (restart);
		}
	}

	sub vcl_synth {
		set resp.http.fail-wal = req.http.fail-wal;
		set resp.http.purged = req.http.purged;
		return (deliver);
	}
} -start

client c1 {
	txreq -req PURGE -hdr "Fail-WAL: 1"
	rxresp
	expect resp.status == 200
	expect resp.http.fail-wal == true
	expect resp.http.purged == -4

	txreq -url "/wal-sequence"
	rxresp
	expect resp.status == 200
	expect resp.http.X-Source == "backend-old"
	expect resp.body == "old-body"
} -run

vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.purgemap_seq == 0
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.persist_failures == 1
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.purgemap_fellow_attr_objects_written == 1

vinyl v1 -stop
vinyl v1 -start
vinyl v1 -expect n_vampireobject == 1

client c2 {
	txreq -req PURGE
	rxresp
	expect resp.status == 200
	expect resp.http.purged == -1

	txreq -url "/wal-sequence"
	rxresp
	expect resp.status == 200
	expect resp.http.X-Source == "backend-new"
	expect resp.body == "new-body"
} -run

vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.purgemap_fellow_direct_probes >= 1
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.purgemap_probe_hard_hits >= 1

server s1 -wait
