vtest "cachetag purgemap Fellow fails closed on object-attribute read failure"

server s1 {
	rxreq
	expect req.url == "/read-failure"
	txresp -hdr "Connection: close" -hdr "X-Source: backend-old" -body "old-body"

	expect_close
	accept

	rxreq
	expect req.url == "/read-failure"
	txresp -hdr "X-Source: backend-new" -body "new-body"
} -start

vinyl v1 \
	-arg "-jnone" \
	-arg "-E${libvmod_slash}" \
	-arg "-sfellow=fellow,${tmpdir}/purgemap-read-failure.stv,100MB,1MB,64KB" \
	-vcl+backend {
	import slash from "${libvmod_slash}";
	import cachetag;

		sub vcl_init {
			slash.tune_fellow(storage.fellow);
			new tags = cachetag.namespace("persistent_pm",
			    persist_path = "${tmpdir}/tag-persist",
			    sweep_interval = 0s);
		}

		sub vcl_recv {
			if (req.method == "PURGE") {
				set req.http.purged = tags.purge("read-failure");
				return (synth(200));
			}
		if (req.method == "FAILATTRREAD") {
			set req.http.armed =
			    tags.test_next_fellow_attr_read_failure();
			return (synth(200));
		}
	}

	sub vcl_backend_response {
		tags.add("read-failure");
		set beresp.ttl = 1h;
	}

	sub vcl_hit {
		if (tags.stale()) {
			return (restart);
		}
	}

	sub vcl_synth {
		set resp.http.purged = req.http.purged;
		set resp.http.armed = req.http.armed;
		return (deliver);
	}
} -start

client c1 {
	txreq -url "/read-failure"
	rxresp
	expect resp.status == 200
	expect resp.http.X-Source == "backend-old"
	expect resp.body == "old-body"
} -run

vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.purgemap_fellow_attr_objects_written == 1
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.volatile_objects == 0
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.volatile_edges == 0

vinyl v1 -stop
vinyl v1 -start
vinyl v1 -expect n_vampireobject == 1
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.volatile_objects == 0
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.volatile_edges == 0

client c2 {
	txreq -req PURGE
	rxresp
	expect resp.status == 200
	expect resp.http.purged == -1

	txreq -req FAILATTRREAD
	rxresp
	expect resp.status == 200
	expect resp.http.armed == true

	txreq -url "/read-failure"
	rxresp
	expect resp.status == 200
	expect resp.http.X-Source == "backend-new"
	expect resp.body == "new-body"
} -run

vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.purgemap_fellow_attr_read_failures >= 1
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.purgemap_fellow_attr_invalid == 0
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.purgemap_probe_hard_hits >= 1
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.purgemap_fellow_store_invariant_failures == 0
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.volatile_objects == 0
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.volatile_edges == 0
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.volatile_side_table_bytes == 0

server s1 -wait
