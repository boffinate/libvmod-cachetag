vtest "purgemap hard purge returns deferred and stale restarts"

server s1 {
	rxreq
	txresp -body "one"

	rxreq
	txresp -body "two"
} -start

vinyl v1 -vcl+backend {
	import cachetag;

	sub vcl_init {
		new tags = cachetag.namespace("default");
	}

	sub vcl_recv {
		if (req.method == "PURGE") {
			set req.http.purged = tags.purge("site");
			return (synth(200));
		}
	}

	sub vcl_backend_response {
		tags.add("site");
	}

	sub vcl_hit {
		if (tags.stale()) {
			return (restart);
		}
	}

	sub vcl_synth {
		set resp.http.purged = req.http.purged;
		return (deliver);
	}
} -start

client c1 {
	txreq
	rxresp
	expect resp.status == 200
	expect resp.body == "one"

	txreq -req PURGE
	rxresp
	expect resp.status == 200
	expect resp.http.purged == -1

	txreq
	rxresp
	expect resp.status == 200
	expect resp.body == "two"
} -run
