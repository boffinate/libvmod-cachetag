vtest "cachetag purgemap Fellow twenty folds round trip in one FDO attribute"

barrier b_backend_closed cond 2

server s1 {
	rxreq
	expect req.url == "/twenty-fold-attr"
	txresp -hdr "Connection: close" -hdr "X-Source: backend-old" -body "old-body"

	expect_close
	barrier b_backend_closed sync
	accept

	rxreq
	expect req.url == "/twenty-fold-attr"
	txresp -hdr "X-Source: backend-new" -body "new-body"
} -start

vinyl v1 \
	-arg "-jnone" \
	-arg "-E${libvmod_slash}" \
	-arg "-sfellow=fellow,${tmpdir}/purgemap-twenty-fold.stv,100MB,1MB,64KB" \
	-vcl+backend {
	import slash from "${libvmod_slash}";
	import cachetag;

	sub vcl_init {
		slash.tune_fellow(storage.fellow);
		new tags = cachetag.namespace("persistent_pm",
		    persist_path = "${tmpdir}/tag-persist",
		    max_keys_per_object = 255,
		    sweep_interval = 0s);
	}

	sub vcl_recv {
		if (req.method == "PURGE") {
			set req.http.purged = tags.purge("fold-t");
			return (synth(200));
		}
	}

	sub vcl_backend_response {
		tags.add("fold-a");
		tags.add("fold-b");
		tags.add("fold-c");
		tags.add("fold-d");
		tags.add("fold-e");
		tags.add("fold-f");
		tags.add("fold-g");
		tags.add("fold-h");
		tags.add("fold-i");
		tags.add("fold-j");
		tags.add("fold-k");
		tags.add("fold-l");
		tags.add("fold-m");
		tags.add("fold-n");
		tags.add("fold-o");
		tags.add("fold-p");
		tags.add("fold-q");
		tags.add("fold-r");
		tags.add("fold-s");
		tags.add("fold-t");
		set beresp.ttl = 1h;
	}

	sub vcl_hit {
		if (tags.stale()) {
			return (restart);
		}
	}

	sub vcl_synth {
		set resp.http.purged = req.http.purged;
		return (deliver);
	}

	sub vcl_deliver {
		set resp.http.Tag-Objects = tags.objects();
		set resp.http.Tag-Edges = tags.edges();
	}
} -start

client c1 {
	txreq -url "/twenty-fold-attr"
	rxresp
	expect resp.status == 200
	expect resp.http.X-Source == "backend-old"
	expect resp.body == "old-body"
	expect resp.http.Tag-Objects == 0
	expect resp.http.Tag-Edges == 0
} -run

vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.purgemap_fellow_attr_objects_written == 1
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.purgemap_fellow_attr_bytes_written == 208
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.purgemap_fellow_store_invariant_failures == 0

shell {
	test ! -e ${tmpdir}/tag-persist/overflow.log
}

barrier b_backend_closed sync
vinyl v1 -stop
vinyl v1 -start
vinyl v1 -expect n_vampireobject == 1
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.purgemap_fellow_direct_probes == 0

client c2 {
	txreq -req PURGE
	rxresp
	expect resp.status == 200
	expect resp.http.purged == -1

	txreq -url "/twenty-fold-attr"
	rxresp
	expect resp.status == 200
	expect resp.http.X-Source == "backend-new"
	expect resp.body == "new-body"
	expect resp.http.Tag-Objects == 0
	expect resp.http.Tag-Edges == 0
} -run

vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.purgemap_fellow_direct_probes >= 1
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.purgemap_fellow_namespace_records_probed >= 1
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.purgemap_probe_hard_hits >= 1
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.purgemap_fellow_attr_invalid == 0

server s1 -wait
