vtest "cachetag purgemap soft purge reduces once and serves current hit"

server s1 {
	rxreq
	txresp -body "old"
} -start

vinyl v1 -vcl+backend {
	import cachetag;

	sub vcl_init {
		new tags = cachetag.namespace("default");
	}

	sub vcl_recv {
		if (req.method == "SOFTPURGE") {
			set req.http.purged = tags.purge("site", mode = soft);
			return (synth(200));
		}
	}

	sub vcl_backend_response {
		tags.add("site");
	}

	sub vcl_hit {
		if (tags.stale()) {
			return (restart);
		}
	}

	sub vcl_deliver {
		set resp.http.Tag-Objects = tags.objects();
		set resp.http.Tag-Edges = tags.edges();
	}

	sub vcl_synth {
		set resp.http.purged = req.http.purged;
		return (deliver);
	}
} -start

client c1 {
	txreq
	rxresp
	expect resp.status == 200
	expect resp.body == "old"

	txreq -req SOFTPURGE
	rxresp
	expect resp.status == 200
	expect resp.http.purged == -1

	txreq
	rxresp
	expect resp.status == 200
	expect resp.body == "old"
	expect resp.http.Tag-Objects == 1
	expect resp.http.Tag-Edges == 1
} -run

vinyl v1 -expect CACHETAG.vcl1_tags_default.purgemap_probe_soft_hits >= 1
