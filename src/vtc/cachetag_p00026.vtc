vtest "cachetag persistent purge_header allocation rejection stays recoverable"

server s1 {
	rxreq
	expect req.url == "/one"
	txresp -hdr "Connection: close" -hdr "X-Source: one-old" -body "one-old"
	expect_close
	accept

	rxreq
	expect req.url == "/two"
	txresp -hdr "Connection: close" -hdr "X-Source: two-old" -body "two-old"
	expect_close
	accept

	rxreq
	expect req.url == "/one"
	txresp -hdr "Connection: close" -hdr "X-Source: one-new" -body "one-new"
	expect_close
	accept

	rxreq
	expect req.url == "/two"
	txresp -hdr "X-Source: two-new" -body "two-new"
} -start

vinyl v1 \
	-arg "-jnone" \
	-arg "-E${libvmod_slash}" \
	-arg "-sfellow=fellow,${tmpdir}/purgemap-header-alloc.stv,100MB,1MB,64KB" \
	-vcl+backend {
	import slash from "${libvmod_slash}";
	import cachetag;

	sub vcl_init {
		slash.tune_fellow(storage.fellow);
		new tags = cachetag.namespace("persistent_pm",
		    persist_path = "${tmpdir}/tag-persist",
		    sweep_interval = 0s);
	}

	sub vcl_recv {
		if (req.method == "PURGE") {
			if (req.http.Fail-Alloc == "1") {
				set req.http.fail-alloc =
				    tags.test_fail_next_key_purge_batch_alloc();
			}
			set req.http.purged = tags.purge_header("one,two");
			return (synth(200));
		}
	}

	sub vcl_backend_response {
		if (bereq.url == "/one") {
			tags.add("one");
		} else {
			tags.add("two");
		}
		set beresp.ttl = 1h;
	}

	sub vcl_hit {
		if (tags.stale()) {
			return (restart);
		}
	}

	sub vcl_synth {
		set resp.http.fail-alloc = req.http.fail-alloc;
		set resp.http.purged = req.http.purged;
		return (deliver);
	}
} -start

client c1 {
	txreq -url "/one"
	rxresp
	expect resp.status == 200
	expect resp.http.X-Source == "one-old"

	txreq -url "/two"
	rxresp
	expect resp.status == 200
	expect resp.http.X-Source == "two-old"

	txreq -req PURGE -hdr "Fail-Alloc: 1"
	rxresp
	expect resp.status == 200
	expect resp.http.fail-alloc == true
	expect resp.http.purged == -2
} -run

vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.limit_rejections == 1
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.persist_failures == 0
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.persist_wal_records == 0
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.purgemap_entries == 0
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.purgemap_seq == 0

client c2 {
	txreq -url "/one"
	rxresp
	expect resp.status == 200
	expect resp.http.X-Source == "one-old"

	txreq -url "/two"
	rxresp
	expect resp.status == 200
	expect resp.http.X-Source == "two-old"

	txreq -req PURGE
	rxresp
	expect resp.status == 200
	expect resp.http.purged == -1
} -run

vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.purgemap_entries == 2
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.purgemap_seq == 1
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.persist_failures == 0

vinyl v1 -stop
vinyl v1 -start

client c3 {
	txreq -url "/one"
	rxresp
	expect resp.status == 200
	expect resp.http.X-Source == "one-new"

	txreq -url "/two"
	rxresp
	expect resp.status == 200
	expect resp.http.X-Source == "two-new"
} -run

vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.fellow_replayed_records == 1
vinyl v1 -expect CACHETAG.vcl1_tags_persistent_pm.persist_failures == 0

server s1 -wait
