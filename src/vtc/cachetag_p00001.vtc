vtest "cachetag Fellow provider follows warm persistent namespace lifetime"

server s1 {
	rxreq
	expect req.url == "/after-reregister"
	txresp -hdr "X-Source: backend" -body "provider-live"
} -start

vinyl v1 \
	-arg "-jnone" \
	-arg "-E${libvmod_slash}" \
	-arg "-sfellow=fellow,${tmpdir}/provider-lifecycle.stv,100MB,1MB,64KB" \
	-vcl+backend {
	import slash from "${libvmod_slash}";
	import cachetag;

	sub vcl_init {
		slash.tune_fellow(storage.fellow);
		new first = cachetag.namespace("first_pm",
		    persist_path = "${tmpdir}/first-persist",
		    sweep_interval = 0s);
	}
} -start

vinyl v1 -vcl+backend {
	import cachetag;

	sub vcl_init {
		new keep = cachetag.namespace("volatile");
	}
}

vinyl v1 -cliok "vcl.use vcl2"
vinyl v1 -cliok "vcl.discard vcl1"

vinyl v1 -vcl+backend {
	import slash from "${libvmod_slash}";
	import cachetag;

	sub vcl_init {
		slash.tune_fellow(storage.fellow);
		new tags = cachetag.namespace("second_pm",
		    persist_path = "${tmpdir}/second-persist",
		    sweep_interval = 0s);
	}

	sub vcl_backend_response {
		tags.add("lifecycle");
		set beresp.ttl = 1h;
	}
}

vinyl v1 -cliok "vcl.use vcl3"
vinyl v1 -cliok "vcl.discard vcl2"

client c1 {
	txreq -url "/after-reregister"
	rxresp
	expect resp.status == 200
	expect resp.http.X-Source == "backend"
	expect resp.body == "provider-live"
} -run

vinyl v1 -expect CACHETAG.vcl3_tags_second_pm.purgemap_fellow_attr_objects_written == 1
vinyl v1 -expect CACHETAG.vcl3_tags_second_pm.purgemap_fellow_store_invariant_failures == 0
vinyl v1 -expect CACHETAG.vcl3_tags_second_pm.volatile_objects == 0
vinyl v1 -expect CACHETAG.vcl3_tags_second_pm.volatile_edges == 0

server s1 -wait
