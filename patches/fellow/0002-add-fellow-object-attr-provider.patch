+struct fellow_object_attr_provider {
+	unsigned			magic;
+#define FELLOW_OBJECT_ATTR_PROVIDER_MAGIC 0x75df9691
+	const struct stevedore		*stv;
+	fellow_object_attr_size_f	*size;
+	fellow_object_attr_fill_f	*fill;
+	void				*priv;
+};
+
+static pthread_mutex_t fellow_object_attr_mtx = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t fellow_object_attr_cond = PTHREAD_COND_INITIALIZER;
+static struct fellow_object_attr_provider *fellow_object_attr_provider;
+static unsigned fellow_object_attr_refcnt;
+
+static struct fellow_object_attr_provider *
+fellow_object_attr_acquire(const struct stevedore *stv)
+{
+	struct fellow_object_attr_provider *provider;
+
+	CHECK_OBJ_NOTNULL(stv, STEVEDORE_MAGIC);
+	AZ(pthread_mutex_lock(&fellow_object_attr_mtx));
+	provider = fellow_object_attr_provider;
+	if (provider != NULL) {
+		CHECK_OBJ_NOTNULL(provider, FELLOW_OBJECT_ATTR_PROVIDER_MAGIC);
+		if (provider->stv != NULL && provider->stv != stv)
+			provider = NULL;
+		else
+			fellow_object_attr_refcnt++;
+	}
+	AZ(pthread_mutex_unlock(&fellow_object_attr_mtx));
+	return (provider);
+}
+
+static void
+fellow_object_attr_release(struct fellow_object_attr_provider *provider)
+{
+
+	CHECK_OBJ_NOTNULL(provider, FELLOW_OBJECT_ATTR_PROVIDER_MAGIC);
+	AZ(pthread_mutex_lock(&fellow_object_attr_mtx));
+	AN(fellow_object_attr_refcnt);
+	fellow_object_attr_refcnt--;
+	if (fellow_object_attr_refcnt == 0)
+		AZ(pthread_cond_broadcast(&fellow_object_attr_cond));
+	AZ(pthread_mutex_unlock(&fellow_object_attr_mtx));
+}
