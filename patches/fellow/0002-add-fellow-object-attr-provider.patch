+#ifndef FELLOW_OBJECT_ATTR_H_INCLUDED
+#define FELLOW_OBJECT_ATTR_H_INCLUDED
+
+#include <stddef.h>
+#include <stdint.h>
+
+struct objcore;
+struct stevedore;
+struct worker;
+
+/*
+ * lets a single user (e.g. a vmod) keep its own data with each fellow
+ * object. it lives in the fdo, so it is covered by the checksum and comes
+ * back with the object after a restart.
+ *
+ * size() is called before we allocate the object and sets *len, 0 means
+ * no data. returning non-zero fails the allocation. fill() then writes
+ * the data.
+ */
+typedef int fellow_object_attr_size_f(void *priv,
+    const struct objcore *oc, size_t *len);
+typedef void fellow_object_attr_fill_f(void *priv,
+    const struct objcore *oc, void *dst, size_t len);
+
+/*
+ * the caller needs to hold a reference on oc. ptr is only valid during
+ * the visit() call. fellow_object_attr_visit() returns what visit()
+ * returns, or one of the below. visit() returning < 0 turns into
+ * FELLOW_OBJECT_ATTR_VISIT_ERROR
+ */
+typedef int fellow_object_attr_visit_f(void *priv,
+    const void *ptr, size_t len);
+
+enum fellow_object_attr_visit_status {
+	FELLOW_OBJECT_ATTR_VISIT_ERROR = -3,
+	FELLOW_OBJECT_ATTR_VISIT_NOT_FELLOW = -2,
+	FELLOW_OBJECT_ATTR_VISIT_ABSENT = -1
+};
+
+/*
+ * only one provider at a time. stv == NULL means all fellow storages.
+ * returns 0 if there already is a provider, stv is not fellow, or calloc
+ * failed.
+ *
+ * unregister waits for size()/fill() calls in flight, so priv can be
+ * freed once it returns
+ */
+uintptr_t fellow_object_attr_register(const struct stevedore *stv,
+    fellow_object_attr_size_f *size, fellow_object_attr_fill_f *fill,
+    void *priv);
+void fellow_object_attr_unregister(uintptr_t *handle);
+int fellow_object_attr_visit(struct worker *wrk, struct objcore *oc,
+    fellow_object_attr_visit_f *visit, void *priv);
+
+#endif
