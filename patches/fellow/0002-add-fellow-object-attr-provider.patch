+/* va_reserve[0] holds the object attribute, the others must be unused */
+static const char *
+fellow_disk_obj_object_attr_check(const struct fellow_disk_obj *fdo)
+{
+	const struct fellow_disk_obj_attr *attr;
+	size_t begin, end, limit, other_begin, other_end;
+
+	AN(fdo);
+	attr = &fdo->va_reserve[0];
+	if (attr->alen == 0) {
+		if (attr->aoff != 0)
+			return ("disk object wrong va_reserve[0] "
+			    "offset without length");
+	} else {
+		begin = attr->aoff;
+		if (begin < offsetof(struct fellow_disk_obj, va_data))
+			return ("disk object wrong va_reserve[0] offset");
+		limit = sizeof *fdo + fdo->va_data_len;
+		if (begin > limit || attr->alen > limit - begin)
+			return ("disk object wrong va_reserve[0] length");
+		end = begin + attr->alen;
+#define FDO_VARATTR(U, l)						\
+		other_begin = fdo->va_##l.aoff;				\
+		other_end = other_begin + fdo->va_##l.alen;		\
+		if (fdo->va_##l.alen > 0 &&				\
+		    begin < other_end && other_begin < end)		\
+			return ("disk object wrong va_reserve[0] "	\
+			    "overlaps " #l);
+#include "tbl/fellow_obj_attr.h"
+	}
+
+	for (unsigned u = 1; u < vcountof(fdo->va_reserve); u++)
+		if (fdo->va_reserve[u].aoff != 0 ||
+		    fdo->va_reserve[u].alen != 0)
+			return ("disk object wrong va_reserve[1..] in use");
+	return (NULL);
+}
