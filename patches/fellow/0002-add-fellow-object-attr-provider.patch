+int
+fellow_cache_obj_object_attr(struct fellow_cache_obj *fco,
+    const void **ptr, size_t *len)
+{
+	const struct fellow_disk_obj_attr *attr;
+	const struct fellow_disk_obj *fdo;
+
+	CHECK_OBJ_NOTNULL(fco, FELLOW_CACHE_OBJ_MAGIC);
+	AN(ptr);
+	AN(len);
