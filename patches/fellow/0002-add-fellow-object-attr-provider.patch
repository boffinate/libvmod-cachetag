+uintptr_t
+fellow_object_attr_register(const struct stevedore *stv,
+    fellow_object_attr_size_f *size, fellow_object_attr_fill_f *fill,
+    void *priv)
+{
+	struct fellow_object_attr_provider *provider;
+	struct stvfe *stvfe;
+
+	AN(size);
+	AN(fill);
+	if (stv != NULL) {
+		CHECK_OBJ_NOTNULL(stv, STEVEDORE_MAGIC);
+		if (! sfe_is(stv))
+			return (0);
+		CAST_OBJ_NOTNULL(stvfe, stv->priv, STVFE_MAGIC);
+		if (stv != stvfe->memstv)
+			return (0);
+	}
+	provider = calloc(1, sizeof *provider);
+	if (provider == NULL)
+		return (0);
+	INIT_OBJ(provider, FELLOW_OBJECT_ATTR_PROVIDER_MAGIC);
+	provider->stv = stv;
+	provider->size = size;
+	provider->fill = fill;
+	provider->priv = priv;
+	AZ(pthread_mutex_lock(&fellow_object_attr_mtx));
+	if (fellow_object_attr_provider != NULL) {
+		AZ(pthread_mutex_unlock(&fellow_object_attr_mtx));
+		FREE_OBJ(provider);
+		return (0);
+	}
+	fellow_object_attr_provider = provider;
+	AZ(pthread_mutex_unlock(&fellow_object_attr_mtx));
+	return ((uintptr_t)provider);
+}
+
+void
+fellow_object_attr_unregister(uintptr_t *handle)
+{
+	struct fellow_object_attr_provider *provider;
+
+	AN(handle);
+	provider = (void *)*handle;
+	if (provider == NULL)
+		return;
+	*handle = 0;
+	CHECK_OBJ_NOTNULL(provider, FELLOW_OBJECT_ATTR_PROVIDER_MAGIC);
+	AZ(pthread_mutex_lock(&fellow_object_attr_mtx));
+	assert(fellow_object_attr_provider == provider);
+	fellow_object_attr_provider = NULL;
+	while (fellow_object_attr_active != 0)
+		AZ(pthread_cond_wait(&fellow_object_attr_cond,
+		    &fellow_object_attr_mtx));
+	AZ(pthread_mutex_unlock(&fellow_object_attr_mtx));
+	FREE_OBJ(provider);
+}
+
+int
+fellow_object_attr_visit(struct worker *wrk, struct objcore *oc,
+    fellow_object_attr_visit_f *visit, void *priv)
+{
+	const struct stevedore *stv;
+	const struct stvfe *stvfe;
+	struct fcoc fcoc;
+	const void *ptr;
+	size_t len;
+	int r;
+
+	CHECK_OBJ_NOTNULL(wrk, WORKER_MAGIC);
+	CHECK_OBJ_NOTNULL(oc, OBJCORE_MAGIC);
+	AN(visit);
+	stv = oc->stobj->stevedore;
+	if (stv == NULL || ! sfe_is(stv))
+		return (FELLOW_OBJECT_ATTR_VISIT_NOT_FELLOW);
+	stvfe = stv_stvfe(stv);
+	if (stv != stvfe->memstv && stv != stvfe->dskstv)
+		return (FELLOW_OBJECT_ATTR_VISIT_NOT_FELLOW);
+	fcoc = stvfe_dskoc_fco(wrk, stv, stvfe, oc, FEP_GET);
+	if (fcoc.fco == NULL)
+		return (FELLOW_OBJECT_ATTR_VISIT_ERROR);
+	r = fellow_cache_obj_object_attr(fcoc.fco, &ptr, &len);
+	if (r != 0) {
+		fcoc_fini(stvfe->fc, &fcoc);
+		return (FELLOW_OBJECT_ATTR_VISIT_ERROR);
+	}
+	if (ptr == NULL) {
+		fcoc_fini(stvfe->fc, &fcoc);
+		return (FELLOW_OBJECT_ATTR_VISIT_ABSENT);
+	}
+
+	/*
+	 * stvfe_dskoc_fco() has completed materialization and returns with no
+	 * Fellow mutex held.  The objcore (or fcoc.fcoref for a lost race) keeps
+	 * the FCO, and therefore the no-copy attribute pointer, alive until after
+	 * this callback returns and fcoc_fini() releases the optional reference.
+	 */
+	r = visit(priv, ptr, len);
+	fcoc_fini(stvfe->fc, &fcoc);
+	return (r < 0 ? FELLOW_OBJECT_ATTR_VISIT_ERROR : r);
+}
+
