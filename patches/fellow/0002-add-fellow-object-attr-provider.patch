+	CHECK_OBJ_NOTNULL(fdo, FELLOW_DISK_OBJ_MAGIC);
+	if (fellow_disk_obj_object_attr_check(fdo) != NULL)
+		return (-1);
+	attr = &fdo->va_reserve[0];
+	if (attr->alen == 0)
+		return (0);
+	*ptr = (const uint8_t *)fdo + attr->aoff;
+	*len = attr->alen;
+	return (0);
+}
+
+void *
+fellow_busy_object_attr(struct fellow_busy *fbo, size_t len)
+{
+	struct fellow_disk_obj_attr *attr;
+	struct fellow_disk_obj *fdo;
+	ptrdiff_t diff;
+	size_t used;
+	void *ptr;
+
+	CHECK_OBJ_NOTNULL(fbo, FELLOW_BUSY_MAGIC);
+	fdo = FCO_FDO(fbo->fco);
+	CHECK_OBJ_NOTNULL(fdo, FELLOW_DISK_OBJ_MAGIC);
+	attr = &fdo->va_reserve[0];
+	AZ(attr->aoff);
+	AZ(attr->alen);
+	if (len == 0)
+		return (NULL);
+	assert(len <= UINT32_MAX);
+	assert(fbo->va_data >= fdo->va_data);
+	used = (size_t)(fbo->va_data - fdo->va_data);
+	assert(used <= fdo->va_data_len);
+	assert(len <= fdo->va_data_len - used);
+	ptr = fbo->va_data;
+	diff = fbo->va_data - (uint8_t *)fdo;
+	assert(diff > 0 && (uintmax_t)diff <= UINT32_MAX);
+	attr->aoff = (uint32_t)diff;
+	attr->alen = (uint32_t)len;
+	fbo->va_data += len;
+	return (ptr);
+}
