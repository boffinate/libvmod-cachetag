@@ -8928,6 +8928,22 @@ fellow_cache_fini(struct fellow_cache **fcp)
 	FREE_OBJ(fc);
 }
 
+void
+fellow_cache_abandon(struct fellow_cache **fcp)
+{
+	struct fellow_cache *fc;
+
+	TAKE_OBJ_NOTNULL(fc, fcp, FELLOW_CACHE_MAGIC);
+
+	/*
+	 * Process shutdown can deliberately leave live objcores attached to
+	 * Fellow cache objects.  Stop background work, but leave the non-empty
+	 * indexes and LRU lists for process exit rather than asserting in fini.
+	 */
+	fellow_cache_shutdown(fc);
+	fellow_cache_async_fini(fc);
+}
