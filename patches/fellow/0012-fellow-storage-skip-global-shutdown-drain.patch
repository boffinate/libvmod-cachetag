+++ b/src/fellow_storage.c
@@ -2921,6 +2921,48 @@ sfe_drain_thread(struct worker *wrk, void *arg)
 	return (NULL);
 }
 
+static void
+sfe_lru_close(struct stvfe *stvfe)
+{
+	CHECK_OBJ_NOTNULL(stvfe, STVFE_MAGIC);
+
+	if (stvfe->dskstv->lru == NULL) {
+		AZ(stvfe->memstv->lru);
+		return;
+	}
+	assert(stvfe->dskstv->lru == stvfe->memstv->lru);
+	stvfe->memstv->lru = NULL;
+
+	if (stvfe->scope == STVFE_GLOBAL && stvfe->shutdown) {
+		/*
+		 * On process shutdown, durable Fellow objects survive in the
+		 * log, but Vinyl's live objcores are about to disappear with
+		 * the child.  Do not spend the manager's stop window draining
+		 * them only to satisfy LRU_Free()'s empty-list assertion.
+		 */
+		stvfe->dskstv->lru = NULL;
+		return;
+	}
+
+	LRU_Free(&stvfe->dskstv->lru);
+	AZ(stvfe->dskstv->lru);
+}
+
+static void
+sfe_cache_close(struct stvfe *stvfe)
+{
+	CHECK_OBJ_NOTNULL(stvfe, STVFE_MAGIC);
+
+	if (stvfe->scope == STVFE_GLOBAL && stvfe->shutdown) {
+		fellow_cache_abandon(&stvfe->fc);
+		AZ(stvfe->fc);
+		return;
+	}
+
+	fellow_cache_fini(&stvfe->fc);
+	AZ(stvfe->fc);
+}
