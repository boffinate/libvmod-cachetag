diff --git a/src/fellow_io_threads.c b/src/fellow_io_threads.c
index a7ba764..4f648e1 100644
--- a/src/fellow_io_threads.c
+++ b/src/fellow_io_threads.c
@@ -26,7 +26,7 @@
 #include <pthread.h>
 #include <limits.h>
 #include <fcntl.h>
-//#include <string.h>
+#include <string.h>
 
 // vinyl
 #include "miniobj.h"
@@ -224,6 +224,26 @@ fellow_io_thread_get_req(struct fellow_io_thread *ctx)
 	return (req);
 }
 
+static void
+fellow_io_thread_return_req(struct fellow_io_thread *ctx,
+    struct fellow_io_thread_r *req)
+{
+	size_t slot;
+
+	CHECK_OBJ_NOTNULL(ctx, FELLOW_IO_THREAD_MAGIC);
+	CHECK_OBJ_NOTNULL(req, FELLOW_IO_THREAD_R_MAGIC);
+
+	assert(req >= ctx->req);
+	slot = (size_t)(req - ctx->req);
+	assert(slot < ctx->free->nbits);
+	memset(req, 0, sizeof *req);
+
+	AZ(pthread_mutex_lock(&ctx->mtx));
+	AZ(bitf_get(ctx->free, slot));
+	AN(bitf_set(ctx->free, slot));
+	AZ(pthread_mutex_unlock(&ctx->mtx));
+}
+
 static void
 fellow_io_thread_task(struct worker *wrk, void *priv)
 {
@@ -288,8 +308,10 @@ fellow_io_async_enq(fellow_ioctx_t *ctxp, enum fellow_io_thread_cmd cmd,
 	req->off = off;
 	req->status.info = info;
 
-	AZ(ctx->taskrun(fellow_io_thread_task, req,
-		&req->taskstate));
+	if (ctx->taskrun(fellow_io_thread_task, req, &req->taskstate)) {
+		fellow_io_thread_return_req(ctx, req);
+		return (0);
+	}
 	return (1);
 }
 
@@ -329,8 +351,10 @@ fellow_io_fallocate_enq(fellow_ioctx_t *ctxp, uint64_t info,
 	req->off = (off_t)offset;
 	req->status.info = info;
 
-	AZ(ctx->taskrun(fellow_io_thread_task, req,
-		&req->taskstate));
+	if (ctx->taskrun(fellow_io_thread_task, req, &req->taskstate)) {
+		fellow_io_thread_return_req(ctx, req);
+		return (0);
+	}
 	return (1);
 }
 
diff --git a/src/fellow_log.c b/src/fellow_log.c
index 20af99e..9aa03e3 100644
--- a/src/fellow_log.c
+++ b/src/fellow_log.c
@@ -3127,13 +3127,20 @@ logbuffer_flush(struct fellow_fd *ffd,
 			continue;
 
-		// need to resubmit - XXX more elegant?
-		lbuf->flush_seq = arr[u]->block->entry[0].seq;
-		u--;
+		// no completions: wait for one, then either resubmit and
+		// advance, or retry this block now that space was freed
+		struct fellow_alloc_log_block *resubmit = arr[u];
+		lbuf->flush_seq = resubmit->block->entry[0].seq;
 
 		r = fellow_io_log_wait_completions(
 		    lbuf->membuddy,
 		    lbuf->fdil.ioctx, 1);
-		AN(r);
+		if (r == 0) {
+			r = fellow_io_log_submit(ffd, NULL,
+			    FAIOT_DLB_FINISH, resubmit);
+			AN(r);
+			continue;
+		}
 		v += r;
+		u--;
 		FDBG(D_LOG_FLUSH, "submit full complete %u", v);
 	}
