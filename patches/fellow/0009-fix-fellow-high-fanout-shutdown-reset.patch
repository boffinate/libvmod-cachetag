From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Peter Bowyer <peter@mapledesign.co.uk>
Date: Sat, 27 Jun 2026 18:13:00 +0100
Subject: [PATCH 9/9] fellow: fix high-fanout shutdown reset

Large cachetag purge benchmarks can leave Fellow close racing with Vinyl
worker-pool shutdown and with Fellow memory LRU threads that are still waiting
on buddy pressure. Stop the Fellow cache explicitly during storage warn-close,
join its LRU threads before final storage destruction, and tolerate worker
queue refusal by returning the async request slot to the IO thread pool so
callers can fall back to synchronous work.

The disk drain also needs more idle polls for large purge/validation workloads
before the final LRU free. Keep the final Fellow cache destruction before
LRU_Free(), so any remaining cache-owned LRU entries are removed before Vinyl
asserts that the storage LRU is empty.
---
 src/fellow_cache.c      | 58 +++++++++++++++++++++++++++++++++++++++----------
 src/fellow_cache.h      |  1 +
 src/fellow_io_threads.c | 34 ++++++++++++++++++++++++-----
 src/fellow_log.c        | 15 +++++++++++----
 src/fellow_storage.c    | 16 ++++++++------
 5 files changed, 98 insertions(+), 27 deletions(-)

diff --git a/src/fellow_cache.c b/src/fellow_cache.c
index fc84c0e..11e78ae 100644
--- a/src/fellow_cache.c
+++ b/src/fellow_cache.c
@@ -115,19 +115,28 @@ fellow_cache_lru_new(struct fellow_cache *fc)
 }
 
 static void
-fellow_cache_lru_fini(struct fellow_cache_lru **lrup)
+fellow_cache_lru_shutdown(struct fellow_cache_lru *lru)
 {
-	struct fellow_cache_lru *lru;
 	void *r;
 
-	TAKE_OBJ_NOTNULL(lru, lrup, FELLOW_CACHE_LRU_MAGIC);
+	CHECK_OBJ_NOTNULL(lru, FELLOW_CACHE_LRU_MAGIC);
 	if (lru->lru_thread != 0) {
 		AZ(pthread_mutex_lock(&lru->lru_mtx));
 		AZ(pthread_cond_signal(&lru->lru_cond));
 		AZ(pthread_mutex_unlock(&lru->lru_mtx));
 		AZ(pthread_join(lru->lru_thread, &r));
 		AZ(r);
+		lru->lru_thread = 0;
 	}
+}
+
+static void
+fellow_cache_lru_fini(struct fellow_cache_lru **lrup)
+{
+	struct fellow_cache_lru *lru;
+
+	TAKE_OBJ_NOTNULL(lru, lrup, FELLOW_CACHE_LRU_MAGIC);
+	fellow_cache_lru_shutdown(lru);
 	assert(VTAILQ_EMPTY(&lru->lru_head));
 	AZ(lru->n);
 	AZ(pthread_cond_destroy(&lru->lru_cond));
@@ -1556,6 +1565,19 @@ fellow_cache_lrus_init(struct fellow_cache_lrus *lrus)
 	AZ(pthread_mutex_init(&lrus->mtx, &fc_mtxattr_errorcheck));
 }
 
+static void
+fellow_cache_lrus_shutdown(struct fellow_cache_lrus *lrus)
+{
+	unsigned u;
+
+	CHECK_OBJ_NOTNULL(lrus, FELLOW_CACHE_LRUS_MAGIC);
+	for (u = 0; u < 1 << MAX_NLRU_EXPONENT; u++) {
+		if (lrus->lru[u] == NULL)
+			continue;
+		fellow_cache_lru_shutdown(lrus->lru[u]);
+	}
+}
+
 static void
 fellow_cache_lrus_fini(struct fellow_cache_lrus *lrus)
 {
@@ -5795,11 +5817,15 @@ fellow_cache_lru_thread(struct worker *wrk, void *priv)
 		VSL_Flush(wrk->vsl, 0);
 #endif
 		stvfe_sumstat(wrk);
+		if (! fc->running)
+			break;
 		buddy_wait_needspace(buddy);
+		if (! fc->running)
+			break;
 		fc->stats->c_mem_lru_wakeups++;
 
 		// drain reserve
-		while (filled > 0 && buddy->waiting > 0) {
+		while (fc->running && filled > 0 && buddy->waiting > 0) {
 			i = --filled;
 
 			AN(r);
@@ -5816,7 +5842,7 @@ fellow_cache_lru_thread(struct worker *wrk, void *priv)
 #endif
 
 		evicted = 0;
-		while (buddy->waiting)
+		while (fc->running && buddy->waiting)
 			evicted += fellow_cache_lru_work(wrk, lru, 1);
 		fc->stats->c_mem_lru_evict_reserve_drained += evicted;
 	}
@@ -8766,19 +8792,29 @@ fellow_cache_init(struct fellow_fd *ffd, buddy_t *membuddy,
 /*
  * the LRU thread is started by the storage layer after loading
  */
+void
+fellow_cache_shutdown(struct fellow_cache *fc)
+{
+	CHECK_OBJ_NOTNULL(fc, FELLOW_CACHE_MAGIC);
+
+	fc->running = 0;
+	buddy_kick(fc->membuddy);
+
+	AZ(pthread_mutex_lock(&fc->async_mtx));
+	AZ(pthread_cond_signal(&fc->async_cond));
+	AZ(pthread_mutex_unlock(&fc->async_mtx));
+
+	fellow_cache_lrus_shutdown(fc->lrus);
+}
+
 void
 fellow_cache_fini(struct fellow_cache **fcp)
 {
 	struct fellow_cache *fc;
-	int i;
 
 	TAKE_OBJ_NOTNULL(fc, fcp, FELLOW_CACHE_MAGIC);
 
-	fc->running = 0;
-	for (i = 0; i < 5; i++) {
-		buddy_kick(fc->membuddy);
-		(void) usleep(10*1000);
-	}
+	fellow_cache_shutdown(fc);
 	fellow_cache_async_fini(fc);
 	AZ(pthread_key_delete(fc->iter_reqs_key));
 	fellow_cache_lrus_fini(fc->lrus);
