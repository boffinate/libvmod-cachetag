{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cms-trace-static-v1 record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "tags"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "pattern": "^\\S+$"},
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "^\\S+$"}
    }
  }
}
